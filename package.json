{
  "name": "zeus-training",
  "displayName": "Zeus Training",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/make-icons.mjs && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.ts",
    "lint": "eslint src tests",
    "check": "npm run lint && npm test && npm run build",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.0",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.47.0",
    "vite": "8.0.13"
  }
}
